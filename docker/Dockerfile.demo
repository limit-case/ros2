# RViz in a browser (noVNC) so the demo can be viewed and screen-recorded from a Mac or any host without
# an X server.   docker build -f docker/Dockerfile.demo -t limit-case-demo .
#                docker run --rm -p 6080:6080 --shm-size=1g -v "$PWD/demo_bag:/bag:ro" limit-case-demo
# then open http://localhost:6080/vnc.html?autoconnect=true&resize=scale  (see docs/recording.md).
ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}
ARG ROS_DISTRO
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-message-filters ros-${ROS_DISTRO}-diagnostic-updater \
    ros-${ROS_DISTRO}-depth-image-proc ros-${ROS_DISTRO}-rviz2 ros-${ROS_DISTRO}-ros2bag \
    ros-${ROS_DISTRO}-rosbag2-storage-mcap ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-launch-ros \
    ros-${ROS_DISTRO}-image-transport libopencv-dev python3-colcon-common-extensions \
    xvfb x11vnc novnc websockify openbox xdotool libgl1-mesa-dri mesa-utils procps \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /ws
COPY . src/limit_case_ros2
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
  && colcon build --packages-select limit_case_ros2 --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF

ENV ROS_DISTRO=${ROS_DISTRO} DISPLAY=:1 LIBGL_ALWAYS_SOFTWARE=1 QT_X11_NO_MITSHM=1 \
    SCREEN=1280x720x24 BAG=/bag
COPY docker/demo_entrypoint.sh /usr/local/bin/demo_entrypoint.sh
RUN chmod +x /usr/local/bin/demo_entrypoint.sh
EXPOSE 6080
ENTRYPOINT ["/usr/local/bin/demo_entrypoint.sh"]
