Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: camera_link
    Frame Rate: 30
    Background Color: 0; 0; 0
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: "Raw cloud by ground truth (red = wrong, white = correct, grey = not glass)"
      Enabled: true
      Topic: {Value: /demo/gt_error_points, Depth: 2, Reliability Policy: Reliable}
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: "True surface from ground truth (green)"
      Enabled: false
      Topic: {Value: /demo/gt_surface_points, Depth: 2, Reliability Policy: Reliable}
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 0.75
      Focal Point: {X: 0.58, Y: -0.05, Z: 0}
      Pitch: 0.45
      Yaw: 2.3
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit start
        Target Frame: <Fixed Frame>
        Distance: 0.75
        Focal Point: {X: 0.58, Y: -0.05, Z: 0}
        Pitch: 0.45
        Yaw: 2.3
      - Class: rviz_default_plugins/Orbit
        Name: Side (depth gap)
        Target Frame: <Fixed Frame>
        Distance: 0.75
        Focal Point: {X: 0.58, Y: -0.05, Z: 0}
        Pitch: 0.02
        Yaw: -1.5708
Window Geometry:
  Height: 720
  Width: 1280
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: false
